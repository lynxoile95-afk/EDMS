# ============================================================
# EDMS-AI  —  environment template.  Copy to .env and edit.
# Values below are development defaults ONLY.
# ============================================================

# --- App ---
APP_NAME="EDMS AI"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost
PUBLIC_BASE_URL=http://localhost:8080

# --- Security ---
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_dev_only_secret_key_do_not_use_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
# local | ldap | oidc   (ldap/oidc are plug-in providers, see app/core/auth_providers.py)
AUTH_PROVIDER=local
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!

# --- Database ---
POSTGRES_USER=edms
POSTGRES_PASSWORD=edms
POSTGRES_DB=edms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://edms:edms@postgres:5432/edms

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (MinIO / S3 compatible) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=edms
S3_REGION=us-east-1
S3_SECURE=false
DOWNLOAD_LINK_TTL_SECONDS=900

# --- Upload limits ---
MAX_UPLOAD_MB=200
ALLOWED_UPLOAD_TYPES=application/pdf

# --- Antivirus hook ---
# true requires a reachable clamd (docker service "clamav" if enabled)
AV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- OCR (Tesseract) ---
OCR_ENABLED=true
# tesseract | paddle   (PaddleOCR is an optional plug-in: pip install paddleocr paddlepaddle)
OCR_ENGINE=tesseract
OCR_LANGS=fas+eng
OCR_DPI=300
TESSERACT_CMD=/usr/bin/tesseract

# --- Optional VLM fallback (OpenAI-compatible; vLLM / Ollama / LM Studio) ---
# NOTE: uploading drawings does NOT need an AI key. Extraction runs on the PDF text
# layer + rules (R01–R22) + Tesseract OCR. The VLM below is only a last-layer helper
# for ambiguous title blocks, and it is off unless BOTH are true:
#   1) VLM_ENABLED=true here, and
#   2) the project setting `vlm_fallback` is true (PUT /projects/{id}/settings).
# The endpoint must be on-premise (localhost, vlm, 10.x, 192.168.x, 172.x, *.local,
# *.internal); a public URL is refused so drawings never leave the network.
VLM_ENABLED=false
VLM_BASE_URL=http://vlm:8000/v1
VLM_API_KEY=EMPTY               # <-- the AI key goes here
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLM_TIMEOUT_SECONDS=90
VLM_MAX_CALLS_PER_DOCUMENT=2

# --- Email (SMTP) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM="EDMS <no-reply@example.com>"

# --- SMS (pluggable: console | kavenegar) ---
SMS_PROVIDER=console
SMS_API_KEY=

# --- Extraction defaults (can be overridden per project) ---
DEFAULT_TIMEZONE=Asia/Tehran
PIPELINE_VERSION=1.0.0

# --- Frontend build-time ---
VITE_API_BASE_URL=/api/v1
